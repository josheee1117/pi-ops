# Opt-in overlay. Use with:
# docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/compose.env --env-file deploy/local/compose.env.dataasset up -d pi-ops-node-agent
PI_OPS_ALLOWED_CONTAINERS=pi-ops-drill,data-asset-dev-jdk17
PI_OPS_HEALTH_TARGETS=[{"name":"pi-ops-drill","url":"http://pi-ops-drill:8088/health","container":"pi-ops-drill","intervalMs":2000},{"name":"data-asset","url":"http://host.docker.internal:18089/actuator/health","container":"data-asset-dev-jdk17","intervalMs":2000}]
