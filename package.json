{
  "name": "pi-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven AI operations platform with central reasoning and per-node observers.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @pi-ops/protocol build && pnpm -r typecheck",
    "test": "pnpm --filter @pi-ops/protocol build && pnpm -r test",
    "lint": "pnpm -r lint",
    "start:local": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/compose.env up --build",
    "smoke:local": "bash deploy/local/smoke.sh",
    "smoke:pi": "bash deploy/local/smoke-pi.sh",
    "test:plan": "node tools/test-governance/src/cli.mjs plan",
    "test:run": "node tools/test-governance/src/cli.mjs run",
    "test:gate": "node tools/test-governance/src/cli.mjs gate",
    "test:arch": "node tools/test-governance/src/cli.mjs arch",
    "test:governance:self": "node --test tools/test-governance/src/*.test.mjs",
    "test:governance": "pnpm test:governance:self && node tools/test-governance/src/cli.mjs validate && pnpm test:arch && pnpm test:plan"
  }
}
